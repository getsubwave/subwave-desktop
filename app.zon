.{
    .id = "dev.subwave.player",
    .name = "subwave-desktop",
    // No "/" in packaging metadata (safer for generated .app/.desktop names);
    // the in-app header still renders the branded "SUB/WAVE".
    .display_name = "SUBWAVE Player",
    .description = "Native desktop player for the SUB/WAVE internet radio station.",
    .version = "0.2.2",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "linux", "windows" },
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "SUBWAVE",
                .width = 980,
                .height = 660,
                .min_width = 880,
                .min_height = 560,
                .titlebar = "hidden_inset_tall",
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Player canvas", .accessibility_label = "Player", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
