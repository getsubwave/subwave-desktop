.{
    .id = "dev.subwave.player",
    .name = "subwave-desktop",
    // No "/" in packaging metadata (safer for generated .app/.desktop names);
    // the in-app header still renders the branded "SUB/WAVE".
    .display_name = "SUBWAVE Player",
    .description = "Native desktop player for the SUB/WAVE internet radio station.",
    .version = "0.8.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{ "macos", "linux", "windows" },
    .permissions = .{ "view", "command" },
    // "tray": the app installs a status item (main.zig statusItem), which macOS
    // and Windows both honor. Declaring it is also what makes the SDK accept
    // close_policy "hide" on Windows — hiding there removes the taskbar entry,
    // so a status item is the only way back. The GTK host has no tray and logs
    // once.
    .capabilities = .{ "native_views", "gpu_surfaces", "tray" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "SUBWAVE",
                .width = 980,
                .height = 660,
                .min_width = 880,
                .min_height = 560,
                .titlebar = "hidden_inset_tall",
                .restore_state = false,
                .restore_policy = "center_on_primary",
                // See docs/sdk-notes.md: "hide" (the menu-bar-app close) is what
                // macOS/Windows want, but the SDK refuses it at comptime on Linux
                // (GTK host has no tray, so a hidden window would be stranded) and
                // app.zon has no per-platform scoping. The macOS/Windows release
                // workflows flip this to "hide" for their builds.
                .close_policy = "quit",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Player canvas", .accessibility_label = "Player", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
}
