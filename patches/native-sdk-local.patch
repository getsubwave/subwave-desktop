+/* The density to rasterize at. Both gtk_widget_get_scale_factor() and
+ * gdk_surface_get_scale_factor() return an INTEGER, rounded up: on a
+ * fractional-scale compositor (Wayland wp_fractional_scale — e.g. a 4K
+ * panel at 1.6667) they report 2, so the runtime rasterizes a buffer 20%
+ * wider than the surface that then has to be resampled down at present
+ * time. That resample lands on CAIRO_FILTER_NEAREST (the exactness test
+ * below agrees with the same wrong integer), which drops ~1 pixel column
+ * in 6 outright instead of averaging and shreds glyph antialiasing —
+ * solid shapes survive, text turns to mush. gdk_surface_get_scale()
+ * (GTK 4.12+) reports the true fractional scale; the macOS host reads
+ * backingScaleFactor and the Windows host GetDpiForWindow()/96.0, both
+ * fractional, which is why the artifact was Linux-only. Older GTK has no
+ * fractional API at all, so the integer value remains the fallback. */
+static double native_sdk_surface_device_scale(GdkSurface *surface) {
+    if (!surface) return 1.0;
+#if GTK_CHECK_VERSION(4, 12, 0)
+    const double fractional = gdk_surface_get_scale(surface);
+    if (fractional > 0.0) return fractional;
+#endif
+    const int integer_scale = gdk_surface_get_scale_factor(surface);
+    return integer_scale > 0 ? (double)integer_scale : 1.0;
+}
+
+/* Same density, resolved from a widget via its native surface. Falls back
+ * to the widget's integer scale factor while the widget is unrealized (no
+ * surface yet). */
+static double native_sdk_widget_device_scale(GtkWidget *widget) {
+    if (!widget) return 1.0;
+    GtkNative *native = gtk_widget_get_native(widget);
+    GdkSurface *surface = native ? gtk_native_get_surface(native) : NULL;
+    if (surface) return native_sdk_surface_device_scale(surface);
+    const int integer_scale = gtk_widget_get_scale_factor(widget);
+    return integer_scale > 0 ? (double)integer_scale : 1.0;
+}
