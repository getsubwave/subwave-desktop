+/* Local patch (subwave-desktop, 2026-07-18): menu-bar-app close semantics.
+ * While a status item is installed, closing the STARTUP window ("main")
+ * hides the app instead of destroying its one unrecreatable window —
+ * playback and the tray stay alive, and a Dock-icon click unhides it.
+ * Cmd+Q, SIGTERM, and AppleScript quit still terminate through the
+ * normal paths; model-declared windows (the mini player) keep their
+ * real close + on_close dispatch. */
+- (BOOL)windowShouldClose:(NSWindow *)sender {
+    (void)sender;
+    if (self.host.statusItem == nil) return YES;
+    NSString *label = self.host.windowLabels[@(self.windowId)];
+    if ([label isEqualToString:@"main"]) {
+        [NSApp hide:nil];
+        return NO;
+    }
+    return YES;
+}
+
