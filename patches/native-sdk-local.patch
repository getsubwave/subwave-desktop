 - (void)trayMenuItemClicked:(NSMenuItem *)menuItem {
+    /* Local patch (subwave-desktop, 2026-07-18): reserved tray item ids for
+     * app-lifecycle actions the runtime's update loop cannot perform.
+     * 100 = open/unhide + activate the app (the tray's "Open player" row,
+     * pairing with the close-hides-the-app patch above); 101 = quit.
+     * Both still forward through trayCallback so the app's command mapping
+     * sees the selection (it may map to no Msg). */
+    if (menuItem.tag == 100) {
+        [NSApp unhide:nil];
+        [NSApp activateIgnoringOtherApps:YES];
+    } else if (menuItem.tag == 101) {
+        [NSApp terminate:nil];
+        return;
+    }
     if (self.trayCallback) {
         self.trayCallback(self.trayContext, (uint32_t)menuItem.tag);
     }
