<!-- SUB/WAVE player view. Phase 3: cover disc, show, states.
     Validate: native markup check src/app.native -->
<column gap="14" padding="20" grow="1">
  <row cross="center" main="space_between">
    <text size="heading">SUB/WAVE</text>
    <text foreground="text_muted" wrap="false" overflow="ellipsis">{show}</text>
    <text foreground="text_muted">{listeners} listening</text>
  </row>

  <row gap="20" cross="center" grow="1" main="start">
    <avatar image="{cover_id}" size="lg" label="{album}">{initials}</avatar>
    <column gap="4" grow="1" main="center">
      <if test="{has_state}">
        <text foreground="accent">{state_line}</text>
      </if>
      <text size="display" wrap="false" overflow="ellipsis">{title}</text>
      <text size="heading" foreground="text_muted" wrap="false" overflow="ellipsis">{artist}</text>
      <text foreground="text_muted" wrap="false" overflow="ellipsis">{album}</text>
      <row gap="8" cross="center">
        <text foreground="accent">{genre}</text>
        <text foreground="text_muted">on air {elapsed_str}</text>
        <text foreground="text_muted">{dj}</text>
      </row>
    </column>
  </row>

  <chart height="72" y-min="0" y-max="1" baseline="0">
    <series values="{bands}" kind="bar" color="accent" label="Spectrum"/>
  </chart>

  <row gap="10" cross="center" main="center">
    <button variant="secondary" on-press="vol_down" icon="volume" label="Quieter"/>
    <text foreground="text_muted">{vol_pct}%</text>
    <button variant="primary" size="lg" on-press="toggle_play">{play_label}</button>
    <button variant="secondary" on-press="tune_out">Tune out</button>
    <button variant="secondary" on-press="vol_up" icon="volume" label="Louder"/>
  </row>

  <status-bar>{audio_state} · {theme_id} · {listeners} listening</status-bar>
</column>
