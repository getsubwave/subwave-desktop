<!-- Phase 0 spike view: everything the probe observes, rendered flat so
     `native automate snapshot` can read it. Validate: native markup check src/app.native -->
<column gap="6" padding="16">
  <text size="heading">SUB/WAVE stream probe</text>
  <text>audio: {audio_state}  buffering: {buffering}</text>
  <text>positions: {pos_count}  elapsed_ms: {elapsed_ms}</text>
  <text>feed: {feed_count}  outcome: {last_outcome}  http: {http_status}</text>
  <text>title: {title}</text>
  <text>artist: {artist}</text>
  <status-bar>probe · {audio_state} · feeds {feed_count}</status-bar>
</column>
