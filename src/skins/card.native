<!-- Card skin: roomy now-playing card with cover disc, spectrum, transport.
     Validate: native markup check src/skins/card.native -->
<column gap="14" padding="20" grow="1">
  <row cross="center" main="space_between" gap="8">
    <text size="heading">SUB/WAVE</text>
    <text grow="1" foreground="text_muted" wrap="false" overflow="ellipsis">{show}</text>
    <button variant="ghost" size="sm" on-press="toggle_schedule">{schedule_label}</button>
    <button variant="ghost" size="sm" on-press="cycle_theme">{theme_label}</button>
    <button variant="ghost" size="sm" on-press="switch_skin">{skin_label}</button>
  </row>

  <if test="{showing_now}">
  <row gap="20" cross="center" grow="1" main="start">
    <avatar image="{cover_id}" size="lg" label="{album}">{initials}</avatar>
    <column gap="4" grow="1" main="center">
      <if test="{has_state}">
        <text foreground="accent">{state_line}</text>
      </if>
      <text size="display" wrap="false" overflow="ellipsis">{title}</text>
      <text size="heading" foreground="text_muted" wrap="false" overflow="ellipsis">{artist}</text>
      <text foreground="text_muted" wrap="false" overflow="ellipsis">{album}</text>
      <row gap="8" cross="center">
        <text foreground="accent">{genre}</text>
        <text foreground="text_muted">on air {elapsed_str}</text>
        <text foreground="text_muted">{dj}</text>
      </row>
      <if test="{has_booth}">
        <text foreground="text_muted" wrap="true" overflow="ellipsis">“{booth_line}”</text>
      </if>
    </column>
  </row>
  </if>

  <if test="{show_schedule}">
  <scroll grow="1">
    <column gap="6">
      <for each="shows_list" key="name" as="s">
        <row gap="10" cross="center">
          <if test="{s.live}"><text foreground="accent">●</text></if>
          <column gap="0" grow="1">
            <text wrap="false" overflow="ellipsis">{s.name}</text>
            <text size="sm" foreground="text_muted" wrap="false" overflow="ellipsis">{s.topic}</text>
          </column>
          <text size="sm" foreground="text_muted" wrap="false">{s.persona}</text>
        </row>
      </for>
    </column>
  </scroll>
  </if>

  <chart height="60" y-min="0" y-max="1" baseline="0">
    <series values="{bands}" kind="bar" color="accent" label="Spectrum"/>
  </chart>

  <row gap="8" cross="center">
    <text-field text="{req_text}" placeholder="Request a song…" on-input="req_edit" on-submit="submit_req" grow="1"/>
    <button variant="primary" on-press="submit_req">Send</button>
    <text foreground="text_muted" wrap="false" overflow="ellipsis">{req_status}</text>
  </row>

  <row gap="10" cross="center" main="center">
    <button variant="secondary" on-press="vol_down" icon="volume" label="Quieter"/>
    <text foreground="text_muted">{vol_pct}%</text>
    <button variant="primary" size="lg" on-press="toggle_play">{play_label}</button>
    <button variant="secondary" on-press="tune_out">Tune out</button>
    <button variant="secondary" on-press="vol_up" icon="volume" label="Louder"/>
  </row>

  <row gap="8" cross="center">
    <text-field text="{station_text}" placeholder="Tune to another station (address)…" on-input="station_edit" on-submit="tune_station" grow="1"/>
    <button variant="secondary" on-press="tune_station">Tune</button>
  </row>

  <status-bar>{audio_state} · {theme_id} · {listeners} listening</status-bar>
</column>
