<!-- Deck skin: compact hi-fi strip — cover, marquee line, spectrum, transport
     in a dense single column. Validate: native markup check src/skins/deck.native -->
<column gap="8" padding="12" grow="1">
  <row gap="12" cross="center">
    <avatar image="{cover_id}" size="lg" label="{album}">{initials}</avatar>
    <column gap="2" grow="1">
      <text><span weight="bold">{title}</span><span foreground="text_muted"> — {artist}</span></text>
      <row gap="8" cross="center">
        <text size="sm" foreground="accent">{genre}</text>
        <text size="sm" foreground="text_muted" wrap="false" overflow="ellipsis">{elapsed_str} · {dj} · {listeners} on</text>
      </row>
    </column>
    <button variant="ghost" size="sm" on-press="switch_skin">{skin_label}</button>
  </row>

  <if test="{has_state}">
    <text size="sm" foreground="accent">{state_line}</text>
  </if>

  <chart height="48" y-min="0" y-max="1" baseline="0" grow="1">
    <series values="{bands}" kind="bar" color="accent" label="Spectrum"/>
  </chart>

  <row gap="8" cross="center" main="center">
    <button variant="secondary" size="sm" on-press="vol_down" icon="volume" label="Quieter"/>
    <text size="sm" foreground="text_muted">{vol_pct}%</text>
    <button variant="primary" on-press="toggle_play">{play_label}</button>
    <button variant="secondary" size="sm" on-press="tune_out">Tune out</button>
    <button variant="secondary" size="sm" on-press="vol_up" icon="volume" label="Louder"/>
  </row>
</column>
