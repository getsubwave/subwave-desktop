<!-- Mini Player — compact secondary window (420x168, hidden_inset).
     Mirrors the native-constrained Claude Design (Mini Player.dc.html).
     Top strip is the drag region. While the mini is up the full player is
     minimized away (one player surface at a time); EXPAND — or closing
     this window — closes the mini and restores the full player. -->
<column grow="1">
  <row cross="center" gap="10" height="30" padding="6" window-drag="true">
    <spacer width="66"/>
    <text size="sm"><span weight="bold">{upper(station_name)}</span></text>
    <if test="{live_now}">
      <text size="sm" foreground="accent">ON AIR</text>
    </if>
    <spacer grow="1"/>
    <button variant="ghost" size="sm" icon="external-link" label="Open full player" on-press="expand_mini">EXPAND</button>
  </row>
  <row gap="12" cross="center" padding="10" grow="1">
    <card padding="6" label="Cover art sleeve">
      <avatar image="{cover_id}" width="46" height="46" label="Cover art">{initials}</avatar>
    </card>
    <column gap="2" grow="1">
      <text><span weight="bold">{title}</span></text>
      <text size="sm" foreground="text_muted"><span foreground="text">{artist}</span><span foreground="text_muted">{album_line}</span></text>
      <text size="sm" foreground="text_muted">{np_head}</text>
    </column>
    <if test="{like_available}">
      <stack>
        <if test="{like_liked}">
          <button variant="ghost" size="sm" icon="app:heart-fill" label="Liked" on-press="press_like"/>
        </if>
        <else>
          <button variant="ghost" size="sm" icon="app:heart" label="Like this track" on-press="press_like"/>
        </else>
        <tooltip anchor="below">{like_hint} · L</tooltip>
      </stack>
    </if>
    <stack>
      <toggle-button size="sm" selected="{muted}" on-toggle="toggle_mute" icon="volume" label="{mute_label}"/>
      <tooltip anchor="below">{mute_label} · M</tooltip>
    </stack>
    <stack>
      <button variant="outline" icon="app:power" label="{tune_label}" on-press="tune_toggle"/>
      <tooltip anchor="below">{tune_label} · Space</tooltip>
    </stack>
  </row>
  <column padding="8">
    <chart height="20" y-min="0" y-max="1" label="Spectrum">
      <series values="{bands}" kind="bar" color="accent"/>
    </chart>
  </column>
</column>
